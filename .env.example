# ---------------------------------------------------------------------------
# OpEx settings. Copy this file to ".env" and fill in what you have.
# Everything is optional: with no values at all, OpEx runs fully on your laptop
# (local database, rule-based AI fallback). AUDIT.md explains each value step by step.
# ---------------------------------------------------------------------------

# --- App ---
ENV=development                       # set to "production" on Cloud Run
LOG_LEVEL=INFO
SECRET_KEY=                           # long random text; signs login sessions (AUDIT.md step 1)
CORS_ORIGINS=http://localhost:5173    # only needed for "npm run dev"

# --- Database: Supabase Postgres (AUDIT.md step 2). Empty = local SQLite file ---
DATABASE_URL=

# --- Demo behaviour ---
DEMO_MODE=true                        # demo accounts, guest access, demo controls
DEMO_PASSWORD=OpEx-demo-2026          # password for the 4 demo accounts (first start only)
ALLOW_SIGNUP=true                     # let people create viewer accounts themselves
LIVE_PLANT_SPEED=10                   # plant minutes per real minute (1 = real time)

# --- Gemini (AUDIT.md step 3). Use EITHER an API key OR Vertex AI ---
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false       # true = use Vertex AI with the project below instead of the key
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite        # free tier ~500 requests/day; gemini-3.8-flash is smarter but ~20/day free
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_APPLICATION_CREDENTIALS=       # path to a service-account JSON (local Vertex/BigQuery/GCS only)

# --- Optional Google Cloud services (AUDIT.md step 5) ---
BIGQUERY_DATASET=                     # e.g. opex_analytics
BIGQUERY_LOCATION=asia-south1
GCS_BUCKET=                           # e.g. opex-files-yourname
PUBSUB_ALERTS_TOPIC=                  # e.g. opex-alerts
INGEST_API_KEY=                       # protects POST /api/ingest/readings (shop-floor gateways)
